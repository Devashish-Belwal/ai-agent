{
  "name": "ai-agent-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:voice": "bun run --cwd apps/voice-agent dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "bun run --cwd packages/database db:generate",
    "db:migrate": "bun run --cwd packages/database db:migrate",
    "db:migrate:deploy": "bun run --cwd packages/database db:push",
    "db:push": "bun run --cwd packages/database db:push",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "prettier": "^3.5.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}

# ==========================================
# EC2 Instance 2: Backend & Database Environment (.env)
# Location: ~/agentic/.env or ~/agentic/infra/.env
# ==========================================

DOCKERHUB_USERNAME=dabelwal
NODE_ENV=production
PORT=4000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=agentic

# BullMQ Redis
REDIS_URL=redis://redis:6379

# Better-Auth Configuration
BETTER_AUTH_SECRET=replace_with_min_32_characters_random_secret
BETTER_AUTH_URL=https://api.dabelwal.online
WEB_ORIGIN=https://agentic.dabelwal.online

# LiveKit WebRTC Token Configuration
LIVEKIT_URL=wss://livekit.dabelwal.online
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace_with_livekit_secret_matching_instance_3

# AI Provider API Keys
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# ==========================================
# EC2 Instance 3: LiveKit & Voice Agent Environment (.env)
# Location: ~/agentic/.env or ~/agentic/infra/.env
# ==========================================

DOCKERHUB_USERNAME=dabelwal

# LiveKit SFU Server & Voice Agent
LIVEKIT_URL=ws://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace_with_livekit_secret_matching_instance_2

# Backend API Endpoint for RAG Tool Invocations
API_URL=https://api.dabelwal.online

# OpenAI Realtime Voice Model
OPENAI_API_KEY=your_openai_api_key
OPENAI_REALTIME_MODEL=gpt-realtime-mini

# Google Gemini (if fallback model used)
GEMINI_API_KEY=your_gemini_api_key

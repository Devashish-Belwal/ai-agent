# Application Environment
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000

# PostgreSQL Database (with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agentic

# Redis (BullMQ queue & caching)
REDIS_URL=redis://localhost:6379

# Better-Auth Configuration
BETTER_AUTH_SECRET=replace_with_a_secure_random_string_min_32_chars
BETTER_AUTH_URL=http://localhost:4000

# LiveKit Configuration (Self-Hosted on EC2 or Local)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret_must_be_at_least_32_characters_long

# AI Provider Keys (Server default or used by Voice Agent)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector"), uuidOssp(map: "uuid-ossp")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// ==========================================
// USER & AUTHENTICATION (Better-Auth)
// ==========================================

model User {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  role          String    @default("user")
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions            Session[]
  accounts            Account[]
  deviceCodes         DeviceCode[]
  providerCredentials ProviderCredential[]
  agentSessions       AgentSession[]

  @@map("user")
}

model Session {
  id             String   @id @default(uuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  impersonatedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
  @@map("verification")
}

model DeviceCode {
  id              String    @id @default(uuid())
  deviceCode      String    @unique
  userCode        String    @unique
  userId          String?
  clientId        String?
  scope           String?
  status          String
  expiresAt       DateTime
  lastPolledAt    DateTime?
  pollingInterval Int?
  deviceName      String?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("deviceCode")
}

// ==========================================
// CREDENTIAL VAULT (AES-256-GCM)
// ==========================================

model ProviderCredential {
  id         String    @id @default(uuid())
  userId     String
  providerId String    // google | openai | anthropic
  label      String
  ciphertext String
  iv         String
  authTag    String
  keyVersion Int       @default(1)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, providerId, label])
  @@index([userId, providerId])
  @@map("provider_credential")
}

// ==========================================
// REPOSITORY INTELLIGENCE & CODE RAG
// ==========================================

enum RepoStatus {
  PENDING
  INDEXING
  READY
  ERROR
}

model Repository {
  id               String     @id @default(uuid()) @db.Uuid
  url              String     @unique
  owner            String
  name             String
  defaultBranch    String     @default("main") @map("default_branch")
  currentCommitSha String?    @db.VarChar(40) @map("current_commit_sha")
  status           RepoStatus @default(PENDING)
  fileCount        Int        @default(0) @map("file_count")
  chunkCount       Int        @default(0) @map("chunk_count")
  totalSizeBytes   BigInt     @default(0) @map("total_size_bytes")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  indexedFiles  IndexedFile[]
  codeChunks    CodeChunk[]
  codeEdges     CodeEdge[]
  ingestionJobs IngestionJob[]
  conversations ChatConversation[]

  @@index([owner, name])
  @@index([status])
  @@map("repositories")
}

model IndexedFile {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @db.Uuid @map("repository_id")
  commitSha    String   @db.VarChar(40) @map("commit_sha")
  filePath     String   @map("file_path")
  language     String   @default("unknown")
  sizeBytes    Int      @default(0) @map("size_bytes")
  lineCount    Int      @default(0) @map("line_count")
  createdAt    DateTime @default(now()) @map("created_at")

  repository Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  chunks     CodeChunk[]

  @@unique([repositoryId, commitSha, filePath])
  @@index([repositoryId, commitSha])
  @@map("indexed_files")
}

model CodeChunk {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @db.Uuid @map("repository_id")
  fileId       String?  @db.Uuid @map("file_id")
  commitSha    String   @db.VarChar(40) @map("commit_sha")
  filePath     String   @map("file_path")
  language     String   @default("unknown")
  startLine    Int      @map("start_line")
  endLine      Int      @map("end_line")
  content      String
  contentHash  String   @db.VarChar(64) @map("content_hash")
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime @default(now()) @map("created_at")

  repository  Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file        IndexedFile? @relation(fields: [fileId], references: [id], onDelete: Cascade)
  sourceEdges CodeEdge[]   @relation("SourceChunk")
  targetEdges CodeEdge[]   @relation("TargetChunk")

  @@index([repositoryId, commitSha])
  @@index([contentHash])
  @@map("code_chunks")
}

enum RelationType {
  CALLS
  IMPORTS
  USES_TYPE
  EXTENDS
}

model CodeEdge {
  id            String       @id @default(uuid()) @db.Uuid
  repositoryId  String       @db.Uuid @map("repository_id")
  commitSha     String       @db.VarChar(40) @map("commit_sha")
  sourceChunkId String       @db.Uuid @map("source_chunk_id")
  targetChunkId String       @db.Uuid @map("target_chunk_id")
  relationType  RelationType @map("relation_type")
  symbolName    String       @db.VarChar(255) @map("symbol_name")
  sourceFile    String       @db.VarChar(1000) @map("source_file")
  targetFile    String       @db.VarChar(1000) @map("target_file")
  metadata      Json?        @default("{}")
  createdAt     DateTime     @default(now()) @map("created_at")

  repository  Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  sourceChunk CodeChunk  @relation("SourceChunk", fields: [sourceChunkId], references: [id], onDelete: Cascade)
  targetChunk CodeChunk  @relation("TargetChunk", fields: [targetChunkId], references: [id], onDelete: Cascade)

  @@index([sourceChunkId, relationType])
  @@index([targetChunkId, relationType])
  @@index([repositoryId, commitSha, symbolName])
  @@index([repositoryId, sourceFile, targetFile])
  @@map("code_edges")
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
}

model IngestionJob {
  id                 String    @id @default(uuid()) @db.Uuid
  repositoryId       String    @db.Uuid @map("repository_id")
  commitSha          String    @db.VarChar(40) @map("commit_sha")
  status             JobStatus @default(QUEUED)
  progressPercentage Int       @default(0) @map("progress_percentage")
  filesProcessed     Int       @default(0) @map("files_processed")
  chunksCreated      Int       @default(0) @map("chunks_created")
  errorMessage       String?   @map("error_message")
  startedAt          DateTime? @map("started_at")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@index([repositoryId])
  @@map("ingestion_jobs")
}

model ChatConversation {
  id           String   @id @default(uuid()) @db.Uuid
  repositoryId String   @db.Uuid @map("repository_id")
  title        String   @default("New Conversation")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  repository Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  messages   ChatMessage[]

  @@index([repositoryId, updatedAt])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid @map("conversation_id")
  role           String   @db.VarChar(16) // user | assistant | system
  content        String
  citations      Json?    @default("[]")
  tokensUsed     Json?    @map("tokens_used")
  createdAt      DateTime @default(now()) @map("created_at")

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ==========================================
// MULTI-TURN AGENT SESSIONS
// ==========================================

model AgentSession {
  id            String   @id @default(uuid())
  userId        String
  title         String?  @default("Agent Session")
  systemPrompt  String?
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lastMessageAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, lastMessageAt])
  @@map("agent_sessions")
}

{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:migrate:deploy": "bun run --cwd ../../packages/database db:push",
    "db:push": "bun run --cwd ../../packages/database db:push"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "@workspace/database": "workspace:*",
    "@workspace/protocol": "workspace:*",
    "@workspace/rag-core": "workspace:*",
    "better-auth": "^1.2.5",
    "body-parser": "^1.20.3",
    "bullmq": "^5.41.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "livekit-server-sdk": "^2.10.1",
    "morgan": "^1.10.0",
    "openai": "^4.85.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5.7.0"
  }
}
